Ques- Given an integer array nums, return an array answer such that answer[i] is equal to the product of all the elements of nums except nums[i].

Sol- 

#include<iostream>
#include<vector>
using namespace std;
int main(){
    vector<int> v;
    int prod = 1;
    int c, count = 0;
    for(int i=0;i<5;i++){
        int num;
        cout<<"enter a number- "<<endl;
        cin>>num;
        if(num!=0){
            prod = prod * num;
            v.push_back(num);
        } else{
            count++;
            if(count == 1){
                c = i;
            }
        }
    }
    if(count == 0){
        vector<int> ans;
        for(int i=0; i<5; i++){
            int n = prod / v[i];
            ans.push_back(n);
        }
        for(int i = 0; i < 5; i++){
            cout<<ans[i]<<" ";
        }
    }
    else if(count == 1){
        vector<int> ans;
        for(int i=0; i<5; i++){
            if(i == c){
                ans.push_back(prod);
            }
            else{
                ans.push_back(0);
            }
        }
        for(int i = 0; i < 5; i++){
            cout<<ans[i]<<" ";
        }
    }
    else{
        vector<int> ans;
        for(int i=0; i<5; i++){
                ans.push_back(0);
        }
        for(int i = 0; i < 5; i++){
            cout<<ans[i]<<" ";
        }
    }
    return 0;
}
